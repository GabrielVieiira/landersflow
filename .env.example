# =============================================================================
# APP — Configurações Gerais da Aplicação
# =============================================================================
APP_NAME="LanderFlow"
APP_ENV="development"            # development | staging | production
SECRET_KEY="troque-por-uma-chave-segura-de-32-chars"
API_HOST="0.0.0.0"
API_PORT=8000
FRONTEND_URL="http://localhost:8501"

# =============================================================================
# DATABASE — Banco de Dados SQLite (→ Postgres em produção)
# =============================================================================
DATABASE_URL="sqlite+aiosqlite:///./landersflow.db"

# =============================================================================
# GITHUB — Apenas o owner é necessário
# A autenticação para LEITURA de templates E para DEPLOY é feita
# 100% via SSH key (deploy_bot). Não é necessário nenhum token PAT.
# =============================================================================
GITHUB_OWNER="seu-usuario-ou-org"

# Repositório único com todos os templates HTML (lander + offer_section)
GITHUB_REPO_LAYOUTS="layouts"

# =============================================================================
# SSH — Chave do Bot (usada para clone de templates E deploy de páginas)
#
# Setup:
#   1. Gere a chave: ssh-keygen -t ed25519 -f ~/.ssh/deploy_bot
#   2. Adicione ~/.ssh/deploy_bot.pub no GitHub do bot (Settings → SSH Keys)
#   3. Teste a conexão: ssh -i ~/.ssh/deploy_bot -T git@github.com
#
# Opcional — alias no ~/.ssh/config:
#   Host github-bot
#     HostName github.com
#     User git
#     IdentityFile ~/.ssh/deploy_bot
# =============================================================================
DEPLOY_SSH_KEY_PATH="~/.ssh/deploy_bot"

# Diretório local onde repos serão clonados (layouts + repos de páginas).
# Em Windows use caminho absoluto: C:/Users/gabri/landersflow-clones
DEPLOY_LOCAL_CLONE_DIR="/tmp/landersflow-clones"

# Identidade do bot nos commits (aparece no histórico do GitHub)
DEPLOY_BOT_NAME="landersflow-bot"
DEPLOY_BOT_EMAIL="bot@landersflow.internal"

# =============================================================================
# REDTRACK — API de Rastreamento
# =============================================================================
REDTRACK_API_KEY="SUA_API_KEY_REDTRACK"
REDTRACK_API_URL="https://api.redtrack.io"

# =============================================================================
# BUSINESS — Regras de Negócio
# =============================================================================
NICHOS_PERMITIDOS="EMAG,TT,ML,T2D,ED,PT,NPT,VIS"

# Timeout (segundos) para polling de deploy via GitHub Pages
DEPLOY_POLLING_TIMEOUT=300
DEPLOY_POLLING_INTERVAL=15
